# Copy this file to ".env" and fill in your real values.
# The app will auto-load these as defaults in the SMTP Settings tab
# (you can still override them in the GUI before sending).

# SMTP server address
SMTP_SERVER=smtp.gmail.com

# SMTP port (587 for STARTTLS, 465 for SSL)
SMTP_PORT=587

# true = use STARTTLS, false = plain/SSL connection
SMTP_USE_TLS=true

# The email address you are sending FROM
SENDER_EMAIL=your_email@gmail.com

# Your email account's app password (NOT your normal login password
# after 2FA is enabled — generate an "app password" in your account's
# security settings for Gmail/Outlook/Yahoo)
SENDER_PASSWORD=your_app_password_here
